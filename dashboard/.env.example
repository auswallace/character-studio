# Copy this file to .env.local and fill in what you need.
# With no FAL_API_KEY and no WAVESPEED_API_KEY, the app runs in simulate mode:
# image jobs return a grey placeholder and paid routes refuse. Nothing is spent.

# --- Required: Supabase (database and file storage) ---
SUPABASE_URL=                     # https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=                # Project settings > API > anon key

# --- Image and video providers (leave both empty to stay in simulate mode) ---
FAL_API_KEY=                      # fal.ai key: LoRA training, image, and video models
WAVESPEED_API_KEY=                # wavespeed.ai key: image and video models
# SIMULATE=true                   # force simulate mode even when provider keys are set

# --- Prompt writing (text models; these still cost money in simulate mode) ---
GROK_API_KEY=                     # x.ai key, writes and enhances prompts
GEMINI_API_KEY=                   # Google AI Studio key, prompt writing fallback and vision
# GROK_TEXT_MODEL=grok-4-1-fast-non-reasoning     # override the Grok text model
# GROK_VISION_MODEL=grok-4-1-fast-non-reasoning   # override the Grok vision model

# --- Guard rails ---
MAX_DAILY_SPEND_USD=25            # refuse new paid jobs past this total per day (0 turns the cap off)
# ALLOWED_FETCH_HOSTS=cdn.example.com   # extra hosts the server may download from, comma-separated
# FFMPEG_FONT=/path/to/font.ttf         # caption font for ad exports

# --- Face consistency scorer (optional), see scripts/scorer ---
# SCORER_URL=http://127.0.0.1:8765      # URL of the local face-match scorer
# SCORER_TOKEN=                         # shared token the scorer expects

# --- Optional integrations ---
# ELEVENLABS_API_KEY=             # voice for spokesperson ads
# ELEVENLABS_VOICE_ID=            # default ElevenLabs voice
# LATE_API_KEY=                   # post scheduling (Publish tab, hidden by default)
# APIFY_API_KEY=                  # social scraping (Inspiration tab, hidden by default)
# TELEGRAM_BOT_TOKEN=             # job notifications
# TELEGRAM_CHAT_ID=               # chat that receives the notifications

# --- Scripts only (npm run export, npm run smoke) ---
# SUPABASE_SERVICE_ROLE_KEY=      # export script: read every row
# SUPABASE_DB_URL=                # export script: direct Postgres URL for a schema dump
# EXPORT_CONCURRENCY=8            # export script: parallel downloads
# BASE_URL=http://localhost:3000  # smoke test target
